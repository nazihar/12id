{
  "name": "12id-reference-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Reference customer backend for the 12id platform: one tenant, no dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "tenant": "node --env-file-if-exists=.env src/tenant-info.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "typescript": "5.9.2"
  }
}
