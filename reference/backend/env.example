# Copy to .env and fill in. Never commit the copy.

# The 12id platform API, and your organisation's API key (12id operations gives you one).
PLATFORM_API_URL=https://api.12id.naziharitsolution.com
PLATFORM_API_KEY=12id_sk_REPLACE

# Shown once in the console when you set the webhook endpoint (Webhooks).
WEBHOOK_SECRET=whsec_REPLACE

# This stand-in's sign-in: anyone who knows the code can sign in. Your backend has its own users instead.
ACCESS_CODE=REPLACE

# Optional.
PORT=3700
DATA_FILE=./data/store.json
TENANT_FILE=./tenant.json
# Where GET /app sends a phone to download the app.
APP_DOWNLOAD_URL=
