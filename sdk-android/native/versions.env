# Pinned inputs of the native artifact (com.12id:holder-sdk-native). Read by build.sh and CI.
# Upstream tag 0.2.1 is the source of the three wrappers the fork was built and verified against
# (askar_uniffi / anoncreds_uniffi 0.2.0-wrapper.1, indy_vdr_uniffi 0.2.1-wrapper.2; README.md).
UPSTREAM_REPO=https://github.com/LF-Decentralized-Trust-labs/aries-uniffi-wrappers.git
UPSTREAM_TAG=0.2.1
UPSTREAM_COMMIT=01def706b44a4095032cd42f0480a5bdfb809961
# The Rust release of the upstream lockfiles' time (2024); newer compilers reject some locked crates.
RUST_TOOLCHAIN=1.77.2
NDK_REVISION=27.2.12479018
ANDROID_API=24
ABIS="arm64-v8a armeabi-v7a x86_64"
