# Secrets: only SOPS-encrypted files (*.sops.*) may be committed
*.env
!*.sops.env
.env*
*.dec
*.decrypted*
secrets/*
!secrets/*.sops.*
!secrets/README.md
*.age
age*.txt
keys.txt
*.key
*.pem
id_ed25519*
*_ed25519
minisign.key

# Node / build output
node_modules/
dist/
build/
*.log

# Local databases and wallets
*.db
*.sqlite
.askar/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Phase 9 W2: non-secret deploy configuration is committed (secrets stay in *.sops.env)
!infra/env/*.env
!infra/env/*/von-network.env
!infra/compose/release.env
# Phase 9 W3: the native build's pinned inputs (no secrets)
!sdk-android/native/versions.env
# Phase 9 W3: public Let's Encrypt root certificates for the sample's network security config (not keys)
!sdk-android/sample/src/main/res/raw/isrg_root_*.pem
!infra/build/
