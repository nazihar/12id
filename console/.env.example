# 12id console (Phase 4). Copy to .env for local development; staging values come from
# infra/staging/secrets/console.sops.env.
DATABASE_URL=postgresql://postgres:spike-only@127.0.0.1:55432/console
BETTER_AUTH_URL=http://localhost:3600
# openssl rand -base64 32
BETTER_AUTH_SECRET=
PLATFORM_API_URL=http://127.0.0.1:3500
# Must equal platform-api's CONSOLE_TOKEN.
CONSOLE_TOKEN=
# Required outside development (email OTP, invitations, password reset).
# SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=12id Console <no-reply@12id.naziharitsolution.com>
