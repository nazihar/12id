{
  "name": "@12id/console",
  "private": true,
  "type": "module",
  "description": "12id console (implement/11-phase-4.md): operator console and tenant portal. TanStack Start + Better Auth; calls platform-api's console scope from server functions only. Own lockfile and image, outside the services workspace.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev --port 3600",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:client": "openapi-typescript ../services/platform-api/openapi.console.json -o src/server/platform-api.d.ts",
    "e2e": "playwright test",
    "check:client": "node scripts/check-client-bundle.ts",
    "db:generate": "auth generate --config src/server/auth.server.ts --output src/server/db/auth-schema.ts --yes && drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "e2e:staging": "playwright test -c playwright.staging.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.54",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.7.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.46.0",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.9",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "srvx": "1.0.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.4",
    "drizzle-kit": "0.31.10",
    "openapi-typescript": "7.13.0",
    "otplib": "13.5.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
