  },
  "dependencies": {
    "@12id/credo-base": "*",
    "@fastify/swagger": "9.8.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.2"
  }
}
