# Every secret the release bundle's compose files mount (implement/28 Q1.6), one line each:
#
#   <stack> <KEY> <kind> [template]
#
# <stack> names the sops file (infra/env/<env>/secrets/<stack>.sops.env) and the run-secrets directory.
# A KEY listed under several stacks is one value written to each (a token both ends share).
# infra/scripts/init.sh secrets fills them; a value already set is kept. Kinds:
#   generate  64 random hex characters (set-secret.sh --generate): tokens, database passwords (pg-roles.sh
#             needs [A-Za-z0-9]{24,}), Askar store keys, the write probe's seed
#   base64    32 random bytes, base64 (the biometric master key)
#   derived   the template with {KEY} replaced by that key's value
#   prompt    asked for, hidden; required
#   optional  asked for, hidden; may be left empty (the feature is then off)
#   empty     not set: deploy.sh mounts an empty file (used only during a rotation)
# infra/scripts/check-secrets-list.sh checks this file against the compose files' `file:` lines.

mediator   POSTGRES_PASSWORD                generate
mediator   MEDIATOR_DB_PASSWORD             generate
mediator   MEDIATOR_ASKAR_STORE_KEY         generate
mediator   MEDIATOR_ADMIN_TOKEN             generate
mediator   MEDIATOR_WEBHOOK_URL             derived   http://platform-api:3500/internal/mediator/{MEDIATOR_WEBHOOK_SECRET}

agent      AGENT_POSTGRES_PASSWORD          generate
agent      AGENT_ASKAR_STORE_KEY            generate
agent      AGENT_SERVICE_DB_PASSWORD        generate
agent      ENDORSER_DB_PASSWORD             generate
agent      PLATFORM_AGENT_TOKEN             generate
agent      AGENT_ENDORSER_TOKEN             generate

ledger     ENDORSER_ASKAR_STORE_KEY         generate
ledger     LEDGER_PROBE_SEED                generate

platform   PLATFORM_DB_PASSWORD             generate
platform   PLATFORM_AGENT_TOKEN             generate
platform   MEDIATOR_ADMIN_TOKEN             generate
platform   PLATFORM_RO_PASSWORD             generate
platform   MEDIATOR_WEBHOOK_SECRET          generate
platform   PLATFORM_ADMIN_TOKEN             generate
platform   CONSOLE_TOKEN                    generate

biometric  BIOMETRIC_DB_PASSWORD            generate
biometric  BIOMETRIC_MASTER_KEY             base64
biometric  BIOMETRIC_INTERNAL_TOKEN         generate
# 12id's own AWS principal for face checks (runbooks/biometric-service.md); empty = no AWS face checks.
biometric  BIOMETRIC_AWS_ACCESS_KEY_ID      optional
biometric  BIOMETRIC_AWS_SECRET_ACCESS_KEY  optional

console    CONSOLE_DB_PASSWORD              generate
console    BETTER_AUTH_SECRET               generate
console    BETTER_AUTH_SECRET_PREVIOUS      empty
console    CONSOLE_TOKEN                    generate
# smtps://user:password@host:465 or smtp://user:password@host:587, with @ / : in the password URL-encoded.
console    SMTP_URL                         prompt

monitoring GRAFANA_ADMIN_PASSWORD           generate
# The alert mail account's SMTP password, whatever the provider; empty = alerts show in the UI only.
monitoring GMAIL_APP_PASSWORD               optional
monitoring ALERT_WEBHOOK_SECRET             generate
monitoring MONITORING_DB_PASSWORD           generate
