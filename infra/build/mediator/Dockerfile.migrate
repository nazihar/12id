# Migration image (W4): the published mediator image with pnpm pre-baked.
#
# The stock image enables corepack but downloads pnpm on first use, so the migration
# container needs npm registry access at runtime (4-init §7.3). This bakes the pnpm
# versions the repository pins and forbids corepack network access at runtime.
FROM ghcr.io/openwallet-foundation/didcomm-mediator-credo/mediator:375518d@sha256:4e0cbbd28b19c3d473fbc64155b5f19b35da6850642414213664b5bdc8ef7976

# The image drops to user `agent` (uid 1001, home /nonexistent); install as root into a
# shared corepack home instead of the agent user's cache.
USER root
ENV COREPACK_HOME=/opt/corepack

# `cd apps/mediator && pnpm` resolves apps/mediator/package.json -> pnpm@10.7.0.
# The repository root pins pnpm@10.24.0. Bake both.
RUN mkdir -p "$COREPACK_HOME" \
 && corepack install --global pnpm@10.7.0 \
 && corepack install --global pnpm@10.24.0 \
 && chmod -R a+rX "$COREPACK_HOME"

USER agent
ENV COREPACK_ENABLE_NETWORK=0 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# Fail the build, not the deploy, if pnpm would still need the network.
RUN cd /app/apps/mediator && pnpm --version

# Phase 9 W2 (M11): the migration reads STORAGE__DATABASE_URL like the mediator, password from a file.
COPY --chmod=0555 secrets-entrypoint.sh /usr/local/bin/secrets-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/secrets-entrypoint.sh"]
