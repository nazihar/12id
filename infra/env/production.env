# Production (*.12id.com, 18-phase-9-production.md): the non-secret settings of one environment, read
# by infra/scripts/deploy.sh (ENV=production) like staging.env. Secrets: infra/env/production/secrets/.
#
# Values left empty are only known at bring-up (W5): the VM's address, the genesis produced by the
# ceremony, the endorser DID and the mail account. Every compose file refuses to start while a value it
# needs is empty (${VAR:?}), so nothing runs half-configured. Frozen before the first real wallet
# (18-phase-9 "Freeze"): the mediator and agent hostnames, the genesis URL, the namespace, the endorser DID.

ENVIRONMENT=production

CONSOLE_HOST=console.12id.com
API_HOST=api.12id.com
AGENT_HOST=agent.12id.com
MEDIATOR_HOST=mediator.12id.com
GENESIS_HOST=genesis.12id.com
VDR_HOST=vdr.12id.com

ACME_EMAIL=
# Loopback, plus the gateway hairpinned traffic arrives from if the provider NATs (see staging.env).
EDGE_RATE_LIMIT_EXEMPT=127.0.0.1/8
PUBLIC_IP=

# Our own Indy network (compose.ledger-nodes.yml): the validators' network name and the did:indy
# namespace. GENESIS_SHA256 comes from the ceremony, ENDORSER_DID from bootstrap-endorser.
LEDGER_NETWORK_NAME=twelveid
INDY_NAMESPACE=twelveid
INDY_NETWORK_PRODUCTION=true
GENESIS_VERSION=v1
GENESIS_SHA256=
GENESIS_SIGNING_PUBLIC_KEY=
ENDORSER_DID=
ENDORSER_ALIAS=12id-endorser

BIOMETRIC_ENABLE_MOCK=false
BIOMETRIC_AWS_REGION=ap-south-1

# The owner's 12id.com mail account (owner action).
MAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_EMAIL_TO=

# No public Grafana (review L2): SSH tunnel to 127.0.0.1:3300.
GRAFANA_ROOT_URL=http://127.0.0.1:3300
