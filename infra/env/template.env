# Environment template of the release bundle (Phase 9 W2, 4-init §12.15): copy it to
# infra/env/<name>.env, fill in every value, and deploy with ENV=<name> infra/scripts/deploy.sh <stack>.
# production.env and staging.env are this file filled in. Values are literal (no quotes, no ${...}).
# Secrets never go here; they go in infra/env/<name>/secrets/<stack>.sops.env (runbooks/production-bringup.md).

# A label on metrics and alerts.
ENVIRONMENT=

# Public hostnames, each with a DNS A record to the VM. The mediator and agent hostnames end up in every
# wallet, and the genesis host in every SDK: choose them once.
CONSOLE_HOST=
API_HOST=
AGENT_HOST=
MEDIATOR_HOST=
GENESIS_HOST=
VDR_HOST=

# Certificates for the hostnames above (infra/compose/caddy/Caddyfile):
#   acme   Let's Encrypt (default). Needs public DNS for every hostname and port 80 reachable from the internet.
#   files  your own certificate: one certificate for every hostname (SANs or a wildcard), full chain first,
#          as fullchain.pem and privkey.pem in EDGE_TLS_DIR (default /opt/12id/tls, root-only).
EDGE_TLS=acme
#EDGE_TLS_DIR=/opt/12id/tls
# Only with files and a certificate from your own CA: that CA's certificate (PEM) on the host. The services
# that call these hostnames themselves (agents fetching the genesis, the agent reaching the mediator,
# monitoring's probes, webhooks to your own servers, mail) trust it. Phones must trust it too (SDK guide).
#EDGE_CA_FILE=/opt/12id/tls/ca.pem
# Let's Encrypt account mail (acme only).
ACME_EMAIL=
# Addresses the per-IP limits never apply to (space-separated CIDRs): loopback, plus the gateway the VM's
# own requests arrive from when the provider NATs them back (a hairpin).
EDGE_RATE_LIMIT_EXEMPT=127.0.0.1/8
# Optional. Requests per 10 s from one address to the mediator (default 500) and to the agent's DIDComm
# endpoint (default 200). Phones behind one office Wi-Fi or one carrier address share them: a phone
# makes about 56 mediator and 8 agent requests in the minute it onboards and takes its first credential.
#EDGE_MEDIATOR_LIMIT=500
#EDGE_AGENT_LIMIT=200
# Optional. Requests per minute from one address to the customer API (default 600). A customer's backend
# calls from one address, with three calls or more per new user; raise it for a customer that onboards
# more than about 200 users a minute.
#EDGE_API_LIMIT=600
# The VM's public IPv4: the Indy client ports are advertised in the genesis and probed on it.
PUBLIC_IP=

# Ledger. infra/scripts/init.sh fills GENESIS_SHA256, GENESIS_SIGNING_PUBLIC_KEY and ENDORSER_DID.
# LEDGER_NETWORK_NAME: your own network's name (compose.ledger-nodes.yml), or a name for an existing one.
# INDY_NAMESPACE: the did:indy namespace, matching [a-z][_a-z0-9-]*(:[a-z][_a-z0-9-]*)?.
# GENESIS_SIGNING_PUBLIC_KEY: your minisign public key; every app passes it to the SDK (genesisPublicKeys).
LEDGER_NETWORK_NAME=
INDY_NAMESPACE=
INDY_NETWORK_PRODUCTION=true
GENESIS_VERSION=v1
GENESIS_SHA256=
GENESIS_SIGNING_PUBLIC_KEY=
ENDORSER_DID=
ENDORSER_ALIAS=
# Your own network only. The validators' private Docker network is LEDGER_SUBNET_PREFIX.0/24 (validators
# .11 to .14): choose a range your networks do not use. The ceremony writes it into the genesis, so it is
# fixed afterwards. LEDGER_CLIENT_IPS: one address per validator (comma-separated) when PUBLIC_IP is not
# what phones reach. LEDGER_TRUSTEE_COUNT: trustee keys created by the ceremony.
#LEDGER_SUBNET_PREFIX=192.168.97
#LEDGER_CLIENT_IPS=
#LEDGER_TRUSTEE_COUNT=3
# An existing network only: its validators' client addresses, host:port comma-separated, for monitoring
# (init.sh writes them from the genesis). Default: the four client ports on PUBLIC_IP.
#LEDGER_CLIENT_TARGETS=

# Biometric gate: the mock provider is for tests only.
BIOMETRIC_ENABLE_MOCK=false
BIOMETRIC_AWS_REGION=

# Deployment-wide choices of platform-api. Leave them out to keep the defaults shown.
# RETENTION_DAYS: days the personal data of a finished exchange is kept (0 = until erased on request).
# AUDIT_RETENTION_DAYS: days an audit entry is kept (365 to 3650, or 0 = for ever).
# OPERATOR_APPROVALS: on = adding an operator account, changing its role or unbanning it waits for a
# second operator. Needs at least two operators.
#RETENTION_DAYS=90
#AUDIT_RETENTION_DAYS=730
#OPERATOR_APPROVALS=off

# Console sign-in rules, for every account (implement/24). Leave them out to keep the defaults shown.
# CONSOLE_IDLE_TIMEOUT_MINUTES: a session without activity for this long is signed out.
# CONSOLE_PASSWORD_MAX_AGE_DAYS: a password older than this must be changed first (0 = never).
# CONSOLE_INACTIVITY_DAYS: an account not signed in for this long is disabled and told by mail (0 = never).
# CONSOLE_LOCK_THRESHOLD, CONSOLE_LOCK_MINUTES: wrong passwords in a row that lock an account, and for how long.
#CONSOLE_IDLE_TIMEOUT_MINUTES=15
#CONSOLE_PASSWORD_MAX_AGE_DAYS=90
#CONSOLE_INACTIVITY_DAYS=90
#CONSOLE_LOCK_THRESHOLD=5
#CONSOLE_LOCK_MINUTES=15
# The console auth secret's version: 0 until its first rotation (runbooks/key-rotation.md, "Console auth secret").
CONSOLE_AUTH_SECRET_VERSION=0

# Tuning, optional. Leave them out to keep the defaults shown.
# AGENT_PROCESS_MESSAGES_CONCURRENTLY: the agent handles one DIDComm message at a time across all tenants
# (measured: no gain from true at about 200 exchanges a minute). AGENT_TENANT_SESSION_LIMIT: open tenant
# sessions. *_ASKAR_MAX_CONNECTIONS: Askar's Postgres pool (empty = Askar's own default, 10).
#AGENT_PROCESS_MESSAGES_CONCURRENTLY=false
#AGENT_TENANT_SESSION_LIMIT=100
#AGENT_ASKAR_MAX_CONNECTIONS=
#ENDORSER_ASKAR_MAX_CONNECTIONS=
# Log levels: error, warn, info or debug. Debug lines can carry personal data; use them only to diagnose.
#AGENT_LOG_LEVEL=info
#PLATFORM_LOG_LEVEL=info
#BIOMETRIC_LOG_LEVEL=info
#MEDIATOR_LOG_LEVEL=info

# Console mail sender; alert mail through Alertmanager (its password is the GMAIL_APP_PASSWORD secret of
# the monitoring stack, whatever the provider).
MAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_EMAIL_TO=

# Where Grafana is reached: http://127.0.0.1:3300 over an SSH tunnel unless you publish it yourself.
GRAFANA_ROOT_URL=http://127.0.0.1:3300
