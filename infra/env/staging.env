# Staging (VM id-dev, *.12id.naziharitsolution.com): the non-secret settings of one environment
# (Phase 9 W2). infra/scripts/deploy.sh passes this file to every `docker compose` call with
# --env-file, next to the release bundle's release.env; the compose files and the Caddyfile only use
# the variables below. Secrets are not here: they are in infra/env/staging/secrets/*.sops.env and
# reach the containers as files (deploy.sh, /opt/12id/run-secrets).
#
# The same keys, with placeholders and explanations, are in template.env (the self-hosting template).
# Values are taken literally: no quotes, no ${...} expansion.

ENVIRONMENT=staging

# Public hostnames (DNS: *.12id.naziharitsolution.com -> the VM).
CONSOLE_HOST=12id.naziharitsolution.com
API_HOST=api.12id.naziharitsolution.com
AGENT_HOST=agent.12id.naziharitsolution.com
MEDIATOR_HOST=mediator.12id.naziharitsolution.com
GENESIS_HOST=genesis.12id.naziharitsolution.com
VDR_HOST=vdr.12id.naziharitsolution.com

# Edge. ACME account mail; the addresses exempt from the per-IP limits: the provider gateway that
# hairpinned traffic from this VM arrives from (6-phase-1-findings W1, review I2) and loopback.
ACME_EMAIL=onetwoidadmin@gmail.com
# W4 load test (2026-10-04): 202.4.122.233 is the dev PC that generates the load; remove after the runs.
EDGE_RATE_LIMIT_EXEMPT=10.1.1.1/32 127.0.0.1/8 202.4.122.233/32
# The VM's public address: the Indy client ports are probed on it.
PUBLIC_IP=123.176.58.72

# Ledger (von-network on staging, 17-phase-7 L16). The published genesis version is immutable.
INDY_NAMESPACE=twelveid:staging
INDY_NETWORK_PRODUCTION=false
GENESIS_VERSION=v1
GENESIS_SHA256=6ab9bc1a3ba5ff257454ca8500a41d45756cd02c3db6c280bde51c7b363a835a
# infra/env/staging/genesis-signing.pub, key id 169255404DD823AD (6-phase-1-findings W9).
GENESIS_SIGNING_PUBLIC_KEY=RWStI9hNQFWSFkkkT1AbPYCeDpOk6zzSe3wCAdWYAdr/tbTIpkm9819Q
ENDORSER_DID=did:indy:twelveid:staging:9WnSruRkr6b3V7XX9zPjka
ENDORSER_ALIAS=12id-staging-endorser

# Biometric gate: the mock provider serves the smokes and the console spec. Never true in production.
BIOMETRIC_ENABLE_MOCK=true
BIOMETRIC_AWS_REGION=ap-south-1

# Mail. SMTP_URL (console) and GMAIL_APP_PASSWORD (alerts) are secrets.
MAIL_FROM=12id Console <onetwoidadmin@gmail.com>
ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
ALERT_SMTP_FROM=onetwoidadmin@gmail.com
ALERT_SMTP_USERNAME=onetwoidadmin@gmail.com
ALERT_EMAIL_TO=onetwoidadmin@gmail.com

# Staging keeps Grafana public behind its own login (infra/env/staging/caddy/staging.caddy);
# production reaches it over an SSH tunnel (review L2).
GRAFANA_ROOT_URL=https://grafana.12id.naziharitsolution.com
