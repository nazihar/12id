# Deployed to /opt/12id/von-network/.env; von-network's `manage` script loads it (manage:318).
# Start with the public IP: ./manage start 123.176.58.72

# Web server (ledger browser, /genesis, /register) on localhost only; Caddy fronts it.
# Must not be 0.0.0.0: Docker-published ports bypass ufw, and /register is unauthenticated.
WEB_SERVER_HOST_PORT=127.0.0.1:9000

LEDGER_INSTANCE_NAME=12id-staging
LEDGER_DESCRIPTION=12id Phase 1 staging ledger (von-network)

# Needed by the endorser bootstrap (W3), which calls http://127.0.0.1:9000/register on the VM.
REGISTER_NEW_DIDS=True

LOG_LEVEL=info
RUST_LOG=warning
